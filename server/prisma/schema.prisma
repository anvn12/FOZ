datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  avatarUrl String
  createdAt DateTime @default(now())

  threads   Thread[]
  replies   Reply[]
  likes     Like[]
  following Follow[] @relation("follower")
  followers Follow[] @relation("following")
}

model Thread {
  id         String   @id @default(cuid())
  authorId   String
  content    String   @db.NVarChar(500)
  imageUrl   String?
  likeCount  Int      @default(0)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())

  author  User    @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies Reply[]
  likes   Like[]
}

model Reply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  content   String   @db.NVarChar(500)
  likeCount Int      @default(0)
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  likes  Like[]
}

/// Like targets exactly one thread OR one reply (nullable FK on the other side).
/// MSSQL: do NOT use unfiltered UNIQUE(userId, replyId) — NULL replyId on thread
/// likes collides. Uniqueness enforced by filtered indexes in migration SQL.
model Like {
  id        String   @id @default(cuid())
  userId    String
  threadId  String?
  replyId   String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reply  Reply?  @relation(fields: [replyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, threadId])
  @@index([userId, replyId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  following User @relation("following", fields: [followingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([followerId, followingId])
}
