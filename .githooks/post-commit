#!/bin/sh
#
# post-commit — Extracts [AI-PROMPT] from the commit message and logs it.
# If the line was deleted or left as the placeholder, nothing is logged.
#

# Read the first line of the commit message
FIRST_LINE=$(git log -1 --pretty=%B | head -n 1)

# Check if the first line starts with [AI-PROMPT]
case "$FIRST_LINE" in
    \[AI-PROMPT\]*)
        PROMPT=$(printf '%s\n' "$FIRST_LINE" | sed 's/^\[AI-PROMPT\] //')
        ;;
    *)
        exit 0
        ;;
esac

# Skip if prompt is the placeholder text
PLACEHOLDER="<paste your Copilot Chat prompt here, or DELETE THIS LINE if no AI was used>"
if [ "$PROMPT" = "$PLACEHOLDER" ]; then
    exit 0
fi

# Skip if prompt is empty
if [ -z "$PROMPT" ]; then
    exit 0
fi

# Get git user name, fallback to system username
USERNAME=$(git config user.name)
if [ -z "$USERNAME" ]; then
    USERNAME=$(whoami)
fi

# Get list of files changed in this commit, wrapped in backticks
FILES=$(git diff-tree --no-commit-id --name-only -r HEAD | sed 's/^/`/;s/$/`/' | tr '\n' ' ')

# Timestamp
TIMESTAMP=$(date '+%Y-%m-%d %H:%M')

# Ensure ai-logs directory exists
mkdir -p ai-logs

LOGFILE="ai-logs/${USERNAME}.md"

# Append the log entry
{
    echo ""
    echo "### ${TIMESTAMP}"
    echo "**Tool:** Copilot Chat"
    echo "**Prompt:** \"${PROMPT}\""
    echo "**Files touched:** ${FILES}"
} >> "$LOGFILE"
