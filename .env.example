# Local dev — copy to .env
NODE_ENV=development
DATABASE_URL=postgres://foz:foz@localhost:5432/foz_dev

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# bcrypt
BCRYPT_COST=12

# Cookies
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Test DB (Vitest integration tests)
TEST_DATABASE_URL=postgres://foz:foz@localhost:5432/foz_test
